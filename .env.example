# Required. A reachable Postgres connection string.
# Local dev: `docker compose up -d` starts one matching this exactly.
DATABASE_URL=postgres://contrib_radar:contrib_radar@localhost:5432/contrib_radar

# Optional. Defaults to 3000.
PORT=3000

# Required. GitHub GraphQL has no anonymous tier - a personal access token
# (classic, "public_repo" scope is enough for public repos) is needed for
# every request. https://github.com/settings/tokens
GITHUB_TOKEN=

# Required only for maintainer-sentiment classification (POST /repos/:id/refresh,
# check_issue_feasibility) - the deterministic score still works with no key
# configured, just without the sentiment signal.
# Free, no card required: aistudio.google.com -> "Get API key".
GEMINI_API_KEY=
