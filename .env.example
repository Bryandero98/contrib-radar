# Required. A reachable Postgres connection string.
# Local dev: `docker compose up -d` starts one matching this exactly.
DATABASE_URL=postgres://contrib_radar:contrib_radar@localhost:5432/contrib_radar

# Optional. Defaults to 3000.
PORT=3000

# Required. GitHub GraphQL has no anonymous tier - a personal access token
# (classic, "public_repo" scope is enough for public repos) is needed for
# every request. https://github.com/settings/tokens
GITHUB_TOKEN=

# Required only for maintainer-sentiment classification (POST /repos/:id/refresh,
# check_issue_feasibility) - the deterministic score still works with no key
# configured, just without the sentiment signal.
# Free, no card required: aistudio.google.com -> "Get API key".
GEMINI_API_KEY=

# Required. GitHub OAuth App credentials for dashboard login.
# https://github.com/settings/applications/new - callback URL must be
# ${APP_URL}/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Required. Signs the session JWT stored in the `session` cookie - any long
# random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Required. Used to build GitHub's OAuth callback URL and Stripe's
# checkout success/cancel URLs.
APP_URL=http://localhost:3000

# Required for billing (POST /billing/checkout, POST /billing/webhook).
# Test-mode keys are enough for local development: dashboard.stripe.com/test.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
